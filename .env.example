# Turso Cloud (use both variables on Vercel)
TURSO_DATABASE_URL=libsql://your-database-your-organisation.turso.io
TURSO_AUTH_TOKEN=replace-with-turso-database-token
# Offline development alternative: TURSO_DATABASE_URL=file:.local/pakar.db
SESSION_SECRET=replace-with-at-least-32-random-characters
# JWT_SECRET is accepted as an alias when SESSION_SECRET is absent.
ADMIN_EMAIL=admin@pakar.local
ADMIN_PASSWORD=replace-with-a-strong-password
APP_URL=http://localhost:3000

# Bootstrap staff codes once with node --env-file=.env.local scripts/setup-staff.mjs
# Exactly six digits, stored as strings; do not commit real codes.
ADMIN_LOGIN_CODE=replace-with-six-digits
FINANCE_LOGIN_CODE=replace-with-six-digits
